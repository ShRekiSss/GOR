{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOR",
  "version": "0.5.0",
  "identifier": "com.gor.messenger",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GOR",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#11141c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "GOR messenger",
    "longDescription": "GOR — лёгкий мессенджер в стиле ретро-терминала.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
