{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VAKSA",
  "version": "1.0.4",
  "identifier": "com.gor.messenger",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VAKSA",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0e1621"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost tauri: ws: wss: https: http:; img-src 'self' https: http: data: blob:; media-src 'self' https: http: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "VAKSA messenger (GOR)",
    "longDescription": "VAKSA (GOR) — быстрый мессенджер с тёмной темой.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
