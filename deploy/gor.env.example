# Переменные окружения для systemd-юнита gor.service
# Скопируйте в /etc/gor/gor.env и поправьте под себя.

GOR_PORT=8080
GOR_DB=/var/lib/gor/chat.db
GOR_UPLOADS=/var/lib/gor/uploads
GOR_STATIC=/opt/gor/frontend/build

# Разрешённые Origin для WebSocket, через запятую (помимо своего).
# Нужно, если клиент открывается с другого домена (например, desktop-обёртка).
# GOR_ORIGINS=https://chat.example.com

# Адрес прокси, от которых доверяем X-Real-IP / X-Forwarded-For.
# По умолчанию — только loopback (Caddy/nginx на той же машине).
# GOR_TRUSTED_PROXIES=127.0.0.1,::1

# Ключ GIPHY для поиска GIF (клиенты ищут через /api/giphy,
# ключ не светится в бандле). Без переменной поиск GIF выключен.
# GOR_GIPHY_KEY=ваш_ключ_giphy

TZ=Europe/Moscow
