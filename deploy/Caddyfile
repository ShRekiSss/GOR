# Caddy: автоматический HTTPS (Let's Encrypt) и прокси на GOR.
#
# 1. Установите Caddy: https://caddyserver.com/docs/install
# 2. Замените домен ниже.
# 3. sudo systemctl reload caddy

chat.example.com {
	encode zstd gzip

	# WebSocket и API — без буферизации
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
	}

	# Заголовки безопасности
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /var/log/caddy/gor-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
