[Unit]
Description=GOR messenger server
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/ShRekiSss/GOR

[Service]
Type=simple
User=gor
Group=gor
WorkingDirectory=/opt/gor
ExecStart=/opt/gor/gor
EnvironmentFile=-/etc/gor/gor.env
Restart=always
RestartSec=3
LimitNOFILE=65535

# Изоляция процесса
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/gor
UMask=0077

[Install]
WantedBy=multi-user.target
